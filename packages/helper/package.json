{
  "name": "@kerf/helper",
  "version": "0.1.0",
  "description": "Kerf helper: bridges the Figma plugin and a Silhouette cutter over Bluetooth LE",
  "license": "MIT",
  "homepage": "https://github.com/keoshi/kerf",
  "repository": {
    "type": "git",
    "url": "https://github.com/keoshi/kerf.git",
    "directory": "packages/helper"
  },
  "type": "module",
  "bin": {
    "kerf": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --external:@stoprocent/noble",
    "start": "npm run build && node dist/main.js",
    "dry-run": "npm run build && node dist/main.js --dry-run",
    "probe": "npm run build && node dist/main.js probe",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0"
  },
  "devDependencies": {
    "@kerf/core": "*"
  }
}
